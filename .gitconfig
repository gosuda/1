[alias]
	suda-init = "!f() { s=\"$(git rev-parse --show-toplevel)/.github/scripts/ws.sh\"; [ -f \"$s\" ] || s=\"$(git rev-parse --git-common-dir)/suda-ws.sh\"; [ -f \"$s\" ] || { echo \"suda-init: no .github/scripts/ws.sh in this checkout; run it on main or a current workspace\" >&2; exit 1; }; bash \"$s\" init; }; f"
	suda-ws = "!f() { s=\"$(git rev-parse --git-common-dir)/suda-ws.sh\"; [ -f \"$s\" ] || s=\"$(git rev-parse --show-toplevel)/.github/scripts/ws.sh\"; [ -f \"$s\" ] || { echo \"git: the workspace tools are not installed; run git suda-init\" >&2; exit 1; }; bash \"$s\" \"$@\"; }; f"
	suda-tree = "!git ls-tree -d -r refs/remotes/origin/suda/main"
	ws-sparse = "!f() { git sparse-checkout set .agents .github \"$@\"; }; f"
	ws-new = "!f() { if [ \"$(git config --bool core.sparseCheckout 2>/dev/null)\" = \"true\" ]; then git sparse-checkout add .agents .github 2>/dev/null || true; fi; git suda-ws fetch --filter=blob:none origin && git switch -c \"ws/$1\" origin/suda/main; }; f"
	ws-save = "!git suda-ws save"
	ws-sync = "!f() { git suda-ws fetch --filter=blob:none origin && git rebase --onto origin/suda/main $(git rev-list --max-parents=0 HEAD); }; f"
	ws-land = "!git suda-ws land"
	ws-id = "!git suda-ws change-id"
	ws-ps = "!git suda-ws ps"
	ws-psdiff = "!git suda-ws psdiff"
	ws-autosave = "!git suda-ws autosave"
	ws-resume = "!git suda-ws resume"
	ws-wt = "!git suda-ws wt"
	ws-pr = "!git suda-ws pr"
	ws-exp = "!f() { actor=\"${1:?usage: git ws-exp <actor> <name>}\"; name=\"${2:?usage: git ws-exp <actor> <name>}\"; git sparse-checkout add .agents .github \"experimental/$actor/$name\" 2>/dev/null || true; git suda-ws fetch --filter=blob:none origin && git switch -c \"ws/$actor/exp-$name\" origin/suda/main && mkdir -p \"experimental/$actor/$name\"; }; f"
	ws-graduate = "!f() { src=\"${1:?usage: git ws-graduate experimental/<actor>/<name> <domain>/<name>}\"; dst=\"${2:?usage: git ws-graduate experimental/<actor>/<name> <domain>/<name>}\"; git sparse-checkout add .agents .github \"$src\" \"$dst\" 2>/dev/null || true; mkdir -p \"$(dirname \"$dst\")\" && git mv \"$src\" \"$dst\"; }; f"
	ws-diff = "!f() { b=$(git symbolic-ref --short HEAD); echo \"https://magpie.gosuda.org/diff/$b\"; }; f"
	suda-log = "!f() { git suda-ws fetch --filter=blob:none origin refs/suda/history && git log FETCH_HEAD -- \"$@\"; }; f"
	suda-cl = "!git suda-ws cl"
