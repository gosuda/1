{
  "name": "@gosuda/flats-md",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Flats single-surface live-preview Markdown editor",
  "main": "./dist/index.js",
  "module": "./src/index.js",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./dist/index.js"
    },
    "./dist": "./dist/index.js",
    "./style.css": "./dist/index.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "test:unit": "node --test src/*.test.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/markdown": "1.7.2",
    "lib0": "0.2.114",
    "markdown-it": "15.0.2",
    "mermaid": "11.17.2",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
